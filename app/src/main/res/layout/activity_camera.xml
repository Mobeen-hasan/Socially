<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:layout_marginTop="10dp"
        android:id="@+id/story_image_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_toolbar"
        android:scaleType="centerCrop"/>

    <LinearLayout
        android:layout_marginTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/settings1"
            android:layout_marginEnd="8dp"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
        </LinearLayout>

        <ImageView
            android:id="@+id/close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/right_arrow"
            android:layout_marginStart="8dp"
            app:tint="@color/white" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/back_black"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:padding="16dp">

        <Button
            android:id="@+id/select_story_button"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:background="@drawable/activity_camera_button"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:text="Gallery"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
        </LinearLayout>

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/circle_1"
            android:layout_centerHorizontal="true"
            android:layout_above="@+id/bottom_toolbar"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
        </LinearLayout>

        <Button
            android:id="@+id/upload_story_button"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:background="@drawable/activity_camera_button"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:text="Upload"/>

    </LinearLayout>



</RelativeLayout>