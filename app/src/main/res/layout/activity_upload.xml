<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:id="@+id/top_navigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp"
        android:background="@color/white">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerInParent="true"
            android:text="Cancel"
            android:textColor="@color/maroon_primary"
            android:textSize="16sp"
            android:padding="8dp" />

        <RelativeLayout
            android:id="@+id/recents_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:padding="8dp">

            <TextView
                android:id="@+id/text_recents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Post"
                android:textColor="@color/maroon_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_centerVertical="true" />

        </RelativeLayout>

        <TextView
            android:id="@+id/btn_post"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Post"
            android:textColor="@color/maroon_primary"
            android:layout_centerInParent="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_navigation"
        android:layout_above="@id/bottom_tabs"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/featured_image"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:src="@drawable/dm_poster" />

        <EditText
            android:id="@+id/caption_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Write a caption..."
            android:padding="16dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_tabs"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="4dp">

        <TextView
            android:id="@+id/btn_gallery"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Library"
            android:textColor="@color/maroon_primary"
            android:textSize="16sp"
            android:gravity="center"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btn_photo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Photo"
            android:textColor="@color/maroon_primary"
            android:textSize="16sp"
            android:gravity="center"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btn_video"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Video"
            android:textColor="@color/maroon_primary"
            android:textSize="16sp"
            android:gravity="center"
            android:textStyle="bold"/>

    </LinearLayout>

</RelativeLayout>